{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "../src",
    "outDir": "./compiled",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "declaration": false
  },
  "include": [
    "../src/types.ts",
    "../src/metrics.ts",
    "../src/goals.ts",
    "../src/teamPerformance.ts",
    "../src/digitalPipeline.ts"
  ]
}
